    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="dt" expression="cons.date_consultation" type="id_String"/>
        <mapperTableEntries name="annee" expression="Integer.parseInt(Var.dt.substring(0, 4))" type="id_Integer"/>
        <mapperTableEntries name="sk_temps" expression="Integer.parseInt(Var.dt.replace(&quot;-&quot;, &quot;&quot;))" type="id_Integer"/>
        <mapperTableEntries name="dn" expression="pat.date_naissance == null ? &quot;&quot; : pat.date_naissance" type="id_String"/>
        <mapperTableEntries name="age" expression="Var.dn.matches(&quot;\\d{4}-\\d{2}-\\d{2}&quot;) ? Var.annee - Integer.parseInt(Var.dn.substring(0, 4)) - (Var.dt.substring(5).compareTo(Var.dn.substring(5)) &lt; 0 ? 1 : 0) : null" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="tranche" expression="Var.age == null ? &quot;Inconnu&quot; : Var.age &lt; 18 ? &quot;0-17&quot; : Var.age &lt; 40 ? &quot;18-39&quot; : Var.age &lt; 65 ? &quot;40-64&quot; : Var.age &lt; 80 ? &quot;65-79&quot; : &quot;80+&quot;" type="id_String"/>
