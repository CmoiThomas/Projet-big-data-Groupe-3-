        <mapperTableEntries name="id_deces" expression="dc.id_deces" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_temps" expression="Integer.parseInt(Var.dt.replace(&quot;-&quot;, &quot;&quot;))" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="sk_localisation" expression="Var.lieu.startsWith(&quot;99&quot;) ? -2 : commune.sk_localisation != null ? commune.sk_localisation : departement.sk_localisation != null ? departement.sk_localisation : -1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="sexe" expression="dc.sexe" type="id_String" nullable="true"/>
        <mapperTableEntries name="age_deces" expression="dc.age_deces" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="tranche_age" expression="Var.tranche" type="id_String" nullable="true"/>
        <mapperTableEntries name="date_approximative" expression="dc.date_approximative" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="nb" expression="1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="annee" expression="Var.annee" type="id_Integer" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="dc" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="id_deces" type="id_String" nullable="true"/>
        <mapperTableEntries name="sexe" type="id_String" nullable="true"/>
