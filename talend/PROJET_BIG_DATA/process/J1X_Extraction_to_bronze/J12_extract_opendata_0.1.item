  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="256" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="  String[] f = decoupage.csv(input_row.line, ',');&#xA;  if (f.length &lt; 9) {&#xA;      throw new RuntimeException(&quot;Ligne mal formée (&quot; + f.length + &quot; champs) : &quot; + input_row.line);&#xA;  }&#xA;  output_row.sexe            = f[2];&#xA;  output_row.date_naissance  = f[3];&#xA;  output_row.date_deces      = f[7];&#xA;  output_row.code_lieu_deces = f[8];"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column key="false" length="255" name="sexe" nullable="true" precision="0" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="date_naissance" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="date_deces" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="code_lieu_deces" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
