        <mapperTableEntries name="code_lieu_deces" type="id_String" nullable="true"/>
        <mapperTableEntries name="date_naissance" type="id_String" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="commune" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="code_commune" expression="dc.code_lieu_deces" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_localisation" type="id_Integer" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="departement" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="code_departement" expression="dc.code_lieu_deces == null || dc.code_lieu_deces.length() &lt; 2 ? &quot;&quot; : dc.code_lieu_deces.startsWith(&quot;97&quot;) ? dc.code_lieu_deces.substring(0, 3) : dc.code_lieu_deces.substring(0, 2)" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_localisation" type="id_Integer" nullable="true"/>
      </inputTables>
