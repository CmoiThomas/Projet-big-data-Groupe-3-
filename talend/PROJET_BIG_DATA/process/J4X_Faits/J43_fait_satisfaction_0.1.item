      <uiProperties/>
      <varTables sizeState="INTERMEDIATE" name="Var"/>
      <outputTables sizeState="INTERMEDIATE" name="Travail" columnNameFilter="sat.score == null || (sat.score >= 0 &amp;&amp; sat.score &lt;= 100)">
        <mapperTableEntries name="finess" expression="sat.finess" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_temps" expression="sat.annee * 10000" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="sk_etablissement" expression="site.sk_etablissement != null ? site.sk_etablissement : jur.sk_etablissement != null ? jur.sk_etablissement : -1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="sk_localisation" expression="reg.sk_localisation == null ? -1 : reg.sk_localisation" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="score" expression="sat.score" type="id_Double" nullable="true"/>
        <mapperTableEntries name="nb_repondants" expression="sat.nb_repondants" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="est_classe" expression="sat.nb_repondants != null &amp;&amp; sat.nb_repondants >= context.seuil_classement&#x9;" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="annee" expression="sat.annee" type="id_Integer" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="sat" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="annee" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="finess" type="id_String" nullable="true"/>
        <mapperTableEntries name="finess_geo" type="id_String" nullable="true"/>
        <mapperTableEntries name="region" type="id_String" nullable="true"/>
        <mapperTableEntries name="nb_repondants" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="score" type="id_Double" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="site" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="identifiant_organisation" expression="&quot;F&quot; + sat.finess_geo&#x9;" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_etablissement" type="id_Integer" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="jur" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="finess_etablissement_juridique" expression="sat.finess" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_etablissement" type="id_Integer" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="reg" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="nom_region" expression="sat.region" type="id_String" nullable="true"/>
        <mapperTableEntries name="sk_localisation" type="id_Integer" nullable="true"/>
      </inputTables>
