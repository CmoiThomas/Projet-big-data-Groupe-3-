    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.dim_localisation_travail &quot; +&#xD;&#xA;&quot;SELECT CASE WHEN t.sk_existant IS NOT NULL THEN t.sk_existant &quot; +&#xD;&#xA;&quot;            ELSE t.sk_max + ROW_NUMBER() OVER (PARTITION BY t.nouveau ORDER BY t.niveau, t.code) END, &quot; +&#xD;&#xA;&quot;       t.niveau, t.code_commune, t.nom_commune, t.code_departement, t.nom_departement, t.code_region, t.nom_region, &quot; +&#xD;&#xA;&quot;       '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;FROM ( &quot; +&#xD;&#xA;&quot;  SELECT lm.*, e.sk_localisation AS sk_existant, x.sk_max, IF(e.sk_localisation IS NULL, 1, 0) AS nouveau &quot; +&#xD;&#xA;&quot;  FROM chu_staging.localisation_membres lm &quot; +&#xD;&#xA;&quot;  LEFT JOIN ( &quot; +&#xD;&#xA;&quot;    SELECT sk_localisation, niveau, &quot; +&#xD;&#xA;&quot;           CASE niveau WHEN 'commune' THEN code_commune WHEN 'departement' THEN code_departement ELSE code_region END AS code &quot; +&#xD;&#xA;&quot;    FROM chu_dwh.dim_localisation WHERE sk_localisation > 0 &quot; +&#xD;&#xA;&quot;  ) e ON e.niveau = lm.niveau AND e.code = lm.code &quot; +&#xD;&#xA;&quot;  CROSS JOIN (SELECT COALESCE(MAX(sk_localisation), 0) AS sk_max FROM chu_dwh.dim_localisation) x &quot; +&#xD;&#xA;&quot;) t&quot;"/>
