      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="dt" expression="dc.date_deces" type="id_String"/>
        <mapperTableEntries name="annee" expression="Integer.parseInt(Var.dt.substring(0, 4))" type="id_Integer"/>
        <mapperTableEntries name="lieu" expression="dc.code_lieu_deces == null ? &quot;&quot; : dc.code_lieu_deces" type="id_String"/>
        <mapperTableEntries name="dep" expression="Var.lieu.length() &lt; 2 ? &quot;&quot; : Var.lieu.startsWith(&quot;97&quot;) ? Var.lieu.substring(0, 3) : Var.lieu.substring(0, 2)" type="id_String"/>
        <mapperTableEntries name="tranche" expression="dc.age_deces == null ? &quot;Inconnu&quot; : dc.age_deces &lt; 18 ? &quot;0-17&quot; : dc.age_deces &lt; 40 ? &quot;18-39&quot; : dc.age_deces &lt; 65 ? &quot;40-64&quot; : dc.age_deces &lt; 80 ? &quot;65-79&quot; : &quot;80+&quot;" type="id_String"/>
