    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.rattachement_professionnel PARTITION (load_date = '&quot; + context.load_date + &quot;') &quot; +&#xD;&#xA;&quot;SELECT p.id_professionnel, &quot; +&#xD;&#xA;&quot;       r.identifiant_organisation, &quot; +&#xD;&#xA;&quot;       CASE WHEN r.identifiant_organisation IS NULL THEN 'INCONNU' &quot; +&#xD;&#xA;&quot;            WHEN r.nb_org = 1 THEN 'UNIQUE' ELSE 'PRINCIPAL' END, &quot; +&#xD;&#xA;&quot;       COALESCE(r.nb_org, 0) &quot; +&#xD;&#xA;&quot;FROM chu_staging.professionnel p &quot; +&#xD;&#xA;&quot;LEFT JOIN ( &quot; +&#xD;&#xA;&quot;  SELECT identifiant, identifiant_organisation, nb_org FROM ( &quot; +&#xD;&#xA;&quot;    SELECT a.identifiant, a.identifiant_organisation, &quot; +&#xD;&#xA;&quot;           COUNT(*) OVER (PARTITION BY a.identifiant) AS nb_org, &quot; +&#xD;&#xA;&quot;           ROW_NUMBER() OVER (PARTITION BY a.identifiant ORDER BY &quot; +&#xD;&#xA;&quot;             CASE WHEN substr(a.identifiant_organisation, 1, 1) = 'F' THEN 0 ELSE 1 END, &quot; +&#xD;&#xA;&quot;             CASE WHEN e.code_commune IS NOT NULL AND e.code_commune &lt;> '' THEN 0 ELSE 1 END, &quot; +&#xD;&#xA;&quot;             a.identifiant_organisation) AS rn &quot; +&#xD;&#xA;&quot;    FROM (SELECT DISTINCT trim(identifiant) AS identifiant, trim(identifiant_organisation) AS identifiant_organisation &quot; +&#xD;&#xA;&quot;          FROM chu_raw.activite_pro &quot; +&#xD;&#xA;&quot;          WHERE load_date = '&quot; + context.load_date + &quot;' AND trim(identifiant_organisation) &lt;> '') a &quot; +&#xD;&#xA;&quot;    LEFT JOIN (SELECT identifiant_organisation, code_commune FROM chu_staging.etablissement &quot; +&#xD;&#xA;&quot;               WHERE load_date = '&quot; + context.load_date + &quot;') e &quot; +&#xD;&#xA;&quot;      ON e.identifiant_organisation = a.identifiant_organisation &quot; +&#xD;&#xA;&quot;  ) t WHERE t.rn = 1 &quot; +&#xD;&#xA;&quot;) r ON r.identifiant = p.id_professionnel &quot; +&#xD;&#xA;&quot;WHERE p.load_date = '&quot; + context.load_date + &quot;'&quot;"/>
