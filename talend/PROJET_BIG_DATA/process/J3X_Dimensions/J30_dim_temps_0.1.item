    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.temps_bornes &quot; +&#xD;&#xA;&quot;SELECT MIN(a), MAX(a) FROM ( &quot; +&#xD;&#xA;&quot;  SELECT year(date_consultation) AS a FROM chu_staging.consultation WHERE load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  UNION ALL SELECT year(date_entree) AS a FROM chu_staging.hospitalisation WHERE load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  UNION ALL SELECT year(date_sortie) AS a FROM chu_staging.hospitalisation WHERE load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  UNION ALL SELECT year(date_deces) AS a FROM chu_staging.deces WHERE load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  UNION ALL SELECT annee AS a FROM chu_staging.satisfaction WHERE load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;) u WHERE a BETWEEN 1900 AND year(from_unixtime(unix_timestamp()))&quot;"/>
