    <elementParameter field="CHECK" name="USE_PARQUET" value="false"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.dim_professionnel_travail &quot; +&#xD;&#xA;&quot;SELECT CASE WHEN t.sk_existant IS NOT NULL THEN t.sk_existant &quot; +&#xD;&#xA;&quot;            ELSE t.sk_max + ROW_NUMBER() OVER (PARTITION BY t.nouveau ORDER BY t.id_professionnel) END, &quot; +&#xD;&#xA;&quot;       t.id_professionnel, t.type_identifiant, t.nom_affiche, t.categorie_professionnelle, t.profession, &quot; +&#xD;&#xA;&quot;       t.code_specialite, t.specialite, t.etab_principal_id, t.etab_principal_nom, t.mode_rattachement, &quot; +&#xD;&#xA;&quot;       t.nb_etablissements, '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;FROM ( &quot; +&#xD;&#xA;&quot;  SELECT p.id_professionnel, p.type_identifiant, &quot; +&#xD;&#xA;&quot;         trim(concat_ws(' ', p.civilite, p.prenom, p.nom)) AS nom_affiche, &quot; +&#xD;&#xA;&quot;         p.categorie_professionnelle, p.profession, p.code_specialite, &quot; +&#xD;&#xA;&quot;         CASE WHEN s.specialite IS NULL OR s.specialite = '' THEN 'Non renseignée' ELSE s.specialite END AS specialite, &quot; +&#xD;&#xA;&quot;         COALESCE(r.identifiant_organisation, '') AS etab_principal_id, &quot; +&#xD;&#xA;&quot;         COALESCE(e.raison_sociale, 'Établissement inconnu') AS etab_principal_nom, &quot; +&#xD;&#xA;&quot;         COALESCE(r.mode_rattachement, 'INCONNU') AS mode_rattachement, &quot; +&#xD;&#xA;&quot;         COALESCE(r.nb_etablissements, 0) AS nb_etablissements, &quot; +&#xD;&#xA;&quot;         d.sk_professionnel AS sk_existant, x.sk_max, IF(d.sk_professionnel IS NULL, 1, 0) AS nouveau &quot; +&#xD;&#xA;&quot;  FROM ( &quot; +&#xD;&#xA;&quot;    SELECT id_professionnel, type_identifiant, civilite, nom, prenom, categorie_professionnelle, profession, code_specialite, &quot; +&#xD;&#xA;&quot;           ROW_NUMBER() OVER (PARTITION BY id_professionnel ORDER BY nom) AS rn &quot; +&#xD;&#xA;&quot;    FROM chu_staging.professionnel WHERE load_date = '&quot; + context.load_date + &quot;' AND id_professionnel &lt;> '' &quot; +&#xD;&#xA;&quot;  ) p &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT code_specialite, MAX(specialite) AS specialite FROM chu_staging.specialite &quot; +&#xD;&#xA;&quot;             WHERE load_date = '&quot; + context.load_date + &quot;' GROUP BY code_specialite) s &quot; +&#xD;&#xA;&quot;         ON s.code_specialite = p.code_specialite &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT id_professionnel, identifiant_organisation, mode_rattachement, nb_etablissements &quot; +&#xD;&#xA;&quot;             FROM chu_staging.rattachement_professionnel WHERE load_date = '&quot; + context.load_date + &quot;') r &quot; +&#xD;&#xA;&quot;         ON r.id_professionnel = p.id_professionnel &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT identifiant_organisation, raison_sociale FROM chu_staging.etablissement &quot; +&#xD;&#xA;&quot;             WHERE load_date = '&quot; + context.load_date + &quot;') e &quot; +&#xD;&#xA;&quot;         ON e.identifiant_organisation = r.identifiant_organisation &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT sk_professionnel, id_professionnel_source FROM chu_dwh.dim_professionnel WHERE sk_professionnel > 0) d &quot; +&#xD;&#xA;&quot;         ON d.id_professionnel_source = p.id_professionnel &quot; +&#xD;&#xA;&quot;  CROSS JOIN (SELECT COALESCE(MAX(sk_professionnel), 0) AS sk_max FROM chu_dwh.dim_professionnel) x &quot; +&#xD;&#xA;&quot;  WHERE p.rn = 1 &quot; +&#xD;&#xA;&quot;) t&quot;"/>
