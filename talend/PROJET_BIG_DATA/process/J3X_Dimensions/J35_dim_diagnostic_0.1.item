    <elementParameter field="LABEL" name="PARQUET_NOTE" value="Parquet is only supported if the distribution uses embedded Hive version 0.10 or later."/>
    <elementParameter field="CHECK" name="USE_PARQUET" value="false"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.dim_diagnostic_travail &quot; +&#xD;&#xA;&quot;SELECT CASE WHEN t.sk_existant IS NOT NULL THEN t.sk_existant &quot; +&#xD;&#xA;&quot;            ELSE t.sk_max + ROW_NUMBER() OVER (PARTITION BY t.nouveau ORDER BY t.code_diag) END, &quot; +&#xD;&#xA;&quot;       t.code_diag, t.libelle, t.code_categorie, t.libelle_categorie, t.chapitre_cim10, t.origine, '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;FROM ( &quot; +&#xD;&#xA;&quot;  SELECT m.code_diag, m.libelle, substr(m.code_diag, 1, 3) AS code_categorie, &quot; +&#xD;&#xA;&quot;         COALESCE(c.libelle, '') AS libelle_categorie, substr(m.code_diag, 1, 1) AS chapitre_cim10, m.origine, &quot; +&#xD;&#xA;&quot;         d.sk_diagnostic AS sk_existant, x.sk_max, IF(d.sk_diagnostic IS NULL, 1, 0) AS nouveau &quot; +&#xD;&#xA;&quot;  FROM ( &quot; +&#xD;&#xA;&quot;    SELECT COALESCE(pg.code_diag, h.code_diag) AS code_diag, &quot; +&#xD;&#xA;&quot;           CASE WHEN pg.libelle IS NOT NULL AND pg.libelle &lt;> '' THEN pg.libelle &quot; +&#xD;&#xA;&quot;                WHEN h.libelle IS NOT NULL AND h.libelle &lt;> '' THEN h.libelle ELSE 'Libellé inconnu' END AS libelle, &quot; +&#xD;&#xA;&quot;           CASE WHEN pg.code_diag IS NOT NULL AND h.code_diag IS NOT NULL THEN 'les_deux' &quot; +&#xD;&#xA;&quot;                WHEN pg.code_diag IS NOT NULL THEN 'postgres' ELSE 'hospitalisation' END AS origine &quot; +&#xD;&#xA;&quot;    FROM (SELECT code_diag, libelle FROM chu_staging.diagnostic WHERE load_date = '&quot; + context.load_date + &quot;') pg &quot; +&#xD;&#xA;&quot;    FULL OUTER JOIN ( &quot; +&#xD;&#xA;&quot;      SELECT ho.code_diag, MAX(ho.libelle_diag) AS libelle &quot; +&#xD;&#xA;&quot;      FROM chu_staging.hospitalisation ho &quot; +&#xD;&#xA;&quot;      JOIN (SELECT identifiant_organisation FROM chu_staging.etablissement WHERE load_date = '&quot; + context.load_date + &quot;') e &quot; +&#xD;&#xA;&quot;        ON e.identifiant_organisation = ho.identifiant_organisation &quot; +&#xD;&#xA;&quot;      WHERE ho.load_date = '&quot; + context.load_date + &quot;' AND ho.code_diag &lt;> '' &quot; +&#xD;&#xA;&quot;      GROUP BY ho.code_diag &quot; +&#xD;&#xA;&quot;    ) h ON h.code_diag = pg.code_diag &quot; +&#xD;&#xA;&quot;  ) m &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT code_diag, libelle FROM chu_staging.diagnostic WHERE load_date = '&quot; + context.load_date + &quot;') c &quot; +&#xD;&#xA;&quot;         ON c.code_diag = substr(m.code_diag, 1, 3) &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT sk_diagnostic, code_diag FROM chu_dwh.dim_diagnostic WHERE sk_diagnostic > 0) d &quot; +&#xD;&#xA;&quot;         ON d.code_diag = m.code_diag &quot; +&#xD;&#xA;&quot;  CROSS JOIN (SELECT COALESCE(MAX(sk_diagnostic), 0) AS sk_max FROM chu_dwh.dim_diagnostic) x &quot; +&#xD;&#xA;&quot;) t&quot;"/>
