    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO TABLE chu_staging.dim_localisation_travail SELECT * FROM ( &quot; +&#xD;&#xA;&quot;  SELECT -1 AS sk, 'inconnu' AS niveau, '' AS cc, 'Inconnu' AS nc, '' AS cd, 'Inconnu' AS nd, '' AS cr, 'INCONNU' AS nr, '&quot; + context.load_date + &quot;' AS ld &quot; +&#xD;&#xA;&quot;  FROM (SELECT 1 AS un FROM chu_staging.cog_region WHERE load_date = '&quot; + context.load_date + &quot;' LIMIT 1) a &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT -2 AS sk, 'etranger' AS niveau, '' AS cc, 'Étranger' AS nc, '' AS cd, 'Étranger' AS nd, '' AS cr, 'ETRANGER' AS nr, '&quot; + context.load_date + &quot;' AS ld &quot; +&#xD;&#xA;&quot;  FROM (SELECT 1 AS un FROM chu_staging.cog_region WHERE load_date = '&quot; + context.load_date + &quot;' LIMIT 1) b &quot; +&#xD;&#xA;&quot;) u&quot;"/>
