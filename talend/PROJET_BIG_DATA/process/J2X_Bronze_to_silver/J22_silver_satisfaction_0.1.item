    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="an" expression="row1.annee == null ? &quot;&quot; : row1.annee.trim()" type="id_String"/>
        <mapperTableEntries name="geo" expression="row1.finess_geo == null ? &quot;&quot; : row1.finess_geo.trim()" type="id_String"/>
        <mapperTableEntries name="reg_norm" expression="row1.region == null ? &quot;&quot; : java.text.Normalizer.normalize(row1.region.trim(), java.text.Normalizer.Form.NFD).replaceAll(&quot;\\p{M}&quot;, &quot;&quot;).toUpperCase().replaceAll(&quot;[-']&quot;, &quot; &quot;).replaceAll(&quot;\\s+&quot;, &quot; &quot;).trim()" type="id_String"/>
        <mapperTableEntries name="region" expression="&quot;PACA&quot;.equals(Var.reg_norm) ? &quot;PROVENCE ALPES COTE D AZUR&quot; : &quot;OCEAN INDIEN&quot;.equals(Var.reg_norm) ? (Var.geo.startsWith(&quot;976&quot;) ? &quot;MAYOTTE&quot; : &quot;LA REUNION&quot;) : Var.reg_norm" type="id_String"/>
        <mapperTableEntries name="nb_txt" expression="row1.nb_repondants == null ? &quot;&quot; : row1.nb_repondants.trim()" type="id_String"/>
        <mapperTableEntries name="nb" expression="Var.nb_txt.matches(&quot;\\d+&quot;) ? Integer.valueOf(Var.nb_txt) : null" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="sc_txt" expression="row1.score == null ? &quot;&quot; : row1.score.trim().replace(&quot;,&quot;, &quot;.&quot;)" type="id_String"/>
        <mapperTableEntries name="score" expression="Var.sc_txt.matches(&quot;\\d+(\\.\\d+)?&quot;) ? Double.valueOf(Var.sc_txt) : null" type="id_Double" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="Silver" columnNameFilter="Var.an.matches(&quot;\\d{4}&quot;) &amp;&amp; !Var.geo.isEmpty()">
        <mapperTableEntries name="annee" expression="Integer.valueOf(Var.an)" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="finess" expression="row1.finess == null ? &quot;&quot; : row1.finess.trim()" type="id_String" nullable="true"/>
        <mapperTableEntries name="finess_geo" expression="Var.geo" type="id_String" nullable="true"/>
        <mapperTableEntries name="region" expression="Var.region" type="id_String" nullable="true"/>
        <mapperTableEntries name="nb_repondant" expression="Var.nb" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="score" expression="Var.score" type="id_Double" nullable="true"/>
        <mapperTableEntries name="classement" expression="row1.classement == null ? &quot;&quot; : row1.classement.trim()" type="id_String" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="Rejets" reject="true">
        <mapperTableEntries name="finess_geo" expression="Var.geo" type="id_String" nullable="true"/>
        <mapperTableEntries name="motif" expression="!Var.an.matches(&quot;\\d{4}&quot;) ? &quot;année absente : &quot; + Var.an : &quot;FINESS géographique vide&quot;" type="id_String" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="annee" type="id_String" nullable="true"/>
        <mapperTableEntries name="finess" type="id_String" nullable="true"/>
        <mapperTableEntries name="finess_geo" type="id_String" nullable="true"/>
        <mapperTableEntries name="region" type="id_String" nullable="true"/>
        <mapperTableEntries name="nb_repondants" type="id_String" nullable="true"/>
        <mapperTableEntries name="score" type="id_String" nullable="true"/>
        <mapperTableEntries name="classement" type="id_String" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>
