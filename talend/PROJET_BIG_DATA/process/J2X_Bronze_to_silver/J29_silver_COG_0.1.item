    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.cog_commune PARTITION (load_date = '&quot; + context.load_date + &quot;')&#xD;&#xA;SELECT c.com,&#xD;&#xA;       c.typecom,&#xD;&#xA;       c.libelle,&#xD;&#xA;       CASE WHEN c.dep = '' THEN p.dep ELSE c.dep END,&#xD;&#xA;       CASE WHEN c.reg = '' THEN p.reg ELSE c.reg END&#xD;&#xA;FROM (&#xD;&#xA;  SELECT com, typecom, libelle, dep, reg, comparent,&#xD;&#xA;         ROW_NUMBER() OVER (PARTITION BY com&#xD;&#xA;           ORDER BY CASE typecom WHEN 'COM' THEN 1 WHEN 'ARM' THEN 2 ELSE 3 END) AS rn&#xD;&#xA;  FROM chu_raw.cog_commune&#xD;&#xA;  WHERE millesime = '&quot; + context.cog_millesime + &quot;' AND com &lt;> ''&#xD;&#xA;) c&#xD;&#xA;LEFT JOIN (&#xD;&#xA;  SELECT com, dep, reg FROM chu_raw.cog_commune&#xD;&#xA;  WHERE millesime = '&quot; + context.cog_millesime + &quot;' AND typecom = 'COM'&#xD;&#xA;) p ON p.com = c.comparent&#xD;&#xA;WHERE c.rn = 1&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
