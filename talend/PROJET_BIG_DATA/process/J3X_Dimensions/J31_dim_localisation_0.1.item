    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.localisation_membres SELECT * FROM ( &quot; +&#xD;&#xA;&quot;  SELECT 'commune' AS niveau, c.code_commune AS code, c.code_commune AS code_commune, c.libelle AS nom_commune, &quot; +&#xD;&#xA;&quot;         c.code_departement AS code_departement, d.libelle AS nom_departement, c.code_region AS code_region, r.libelle_norm AS nom_region &quot; +&#xD;&#xA;&quot;  FROM chu_staging.cog_commune c &quot; +&#xD;&#xA;&quot;  LEFT JOIN chu_staging.cog_departement d ON d.code_departement = c.code_departement AND d.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  LEFT JOIN chu_staging.cog_region r ON r.code_region = c.code_region AND r.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  WHERE c.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT 'departement' AS niveau, d.code_departement AS code, '' AS code_commune, '' AS nom_commune, &quot; +&#xD;&#xA;&quot;         d.code_departement AS code_departement, d.libelle AS nom_departement, d.code_region AS code_region, r.libelle_norm AS nom_region &quot; +&#xD;&#xA;&quot;  FROM chu_staging.cog_departement d &quot; +&#xD;&#xA;&quot;  LEFT JOIN chu_staging.cog_region r ON r.code_region = d.code_region AND r.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  WHERE d.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT 'region' AS niveau, r.code_region AS code, '' AS code_commune, '' AS nom_commune, &quot; +&#xD;&#xA;&quot;         '' AS code_departement, '' AS nom_departement, r.code_region AS code_region, r.libelle_norm AS nom_region &quot; +&#xD;&#xA;&quot;  FROM chu_staging.cog_region r WHERE r.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;) u&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="CHECK" name="STORE_BY_HBASE" value="false" show="false"/>
