    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.localisation_controle SELECT * FROM ( &quot; +&#xD;&#xA;&quot;  SELECT 'etablissement' AS source, e.code_commune AS code, COUNT(*) AS nb_lignes &quot; +&#xD;&#xA;&quot;  FROM chu_staging.etablissement e &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT code_commune FROM chu_staging.dim_localisation_travail WHERE niveau = 'commune') c ON c.code_commune = e.code_commune &quot; +&#xD;&#xA;&quot;  WHERE e.load_date = '&quot; + context.load_date + &quot;' AND e.code_commune &lt;> '' AND c.code_commune IS NULL &quot; +&#xD;&#xA;&quot;  GROUP BY e.code_commune &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT 'deces' AS source, d.code_lieu_deces AS code, COUNT(*) AS nb_lignes &quot; +&#xD;&#xA;&quot;  FROM chu_staging.deces d &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT code_commune FROM chu_staging.dim_localisation_travail WHERE niveau = 'commune') c ON c.code_commune = d.code_lieu_deces &quot; +&#xD;&#xA;&quot;  WHERE d.load_date = '&quot; + context.load_date + &quot;' AND substr(d.code_lieu_deces, 1, 2) &lt;> '99' AND c.code_commune IS NULL &quot; +&#xD;&#xA;&quot;  GROUP BY d.code_lieu_deces &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT 'satisfaction' AS source, s.region AS code, COUNT(*) AS nb_lignes &quot; +&#xD;&#xA;&quot;  FROM chu_staging.satisfaction s &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT nom_region FROM chu_staging.dim_localisation_travail WHERE niveau = 'region') r ON r.nom_region = s.region &quot; +&#xD;&#xA;&quot;  WHERE s.load_date = '&quot; + context.load_date + &quot;' AND r.nom_region IS NULL &quot; +&#xD;&#xA;&quot;  GROUP BY s.region &quot; +&#xD;&#xA;&quot;) u&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
