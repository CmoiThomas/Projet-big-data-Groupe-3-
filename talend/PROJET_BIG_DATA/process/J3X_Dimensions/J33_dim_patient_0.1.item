    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE chu_staging.dim_patient_travail&#xD;&#xA;SELECT CASE WHEN x.sk_existant IS NOT NULL THEN x.sk_existant ELSE x.max_sk + x.rang END AS sk_patient,&#xD;&#xA;       x.id_patient_pseudo AS id_patient_pseudo,&#xD;&#xA;       x.sexe AS sexe,&#xD;&#xA;       x.annee_naissance AS annee_naissance,&#xD;&#xA;       '&quot; + context.load_date + &quot;' AS load_date&#xD;&#xA;FROM (&#xD;&#xA;  SELECT s.id_patient_pseudo, s.sexe, YEAR(s.date_naissance) AS annee_naissance,&#xD;&#xA;         d.sk_patient AS sk_existant, m.max_sk,&#xD;&#xA;         ROW_NUMBER() OVER (PARTITION BY CASE WHEN d.sk_patient IS NULL THEN 1 ELSE 0 END&#xD;&#xA;                            ORDER BY s.id_patient_pseudo) AS rang&#xD;&#xA;  FROM (&#xD;&#xA;    SELECT id_patient_pseudo, sexe, date_naissance,&#xD;&#xA;           ROW_NUMBER() OVER (PARTITION BY id_patient_pseudo ORDER BY sexe) AS rn&#xD;&#xA;    FROM chu_staging.patient_pseudo&#xD;&#xA;    WHERE load_date = '&quot; + context.load_date + &quot;'&#xD;&#xA;  ) s&#xD;&#xA;  LEFT JOIN chu_dwh.dim_patient d ON d.id_patient_pseudo = s.id_patient_pseudo&#xD;&#xA;  CROSS JOIN (SELECT COALESCE(MAX(sk_patient), 0) AS max_sk&#xD;&#xA;              FROM chu_dwh.dim_patient WHERE sk_patient > 0) m&#xD;&#xA;  WHERE s.rn = 1&#xD;&#xA;) x&quot;"/>
