    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO TABLE chu_staging.dim_etablissement_travail &quot; +&#xD;&#xA;&quot;SELECT x.sk_max + ROW_NUMBER() OVER (ORDER BY n.identifiant_organisation), &quot; +&#xD;&#xA;&quot;       n.identifiant_organisation, n.type_organisation, n.finess_site, n.finess_juridique, n.raison_sociale, &quot; +&#xD;&#xA;&quot;       n.code_commune, n.code_departement, n.nom_departement, n.nom_region, '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;FROM (SELECT COALESCE(MAX(sk_etablissement), 0) AS sk_max FROM chu_dwh.dim_etablissement) x &quot; +&#xD;&#xA;&quot;CROSS JOIN ( &quot; +&#xD;&#xA;&quot;  SELECT s.identifiant_organisation, s.type_organisation, s.finess_site, s.finess_juridique, s.raison_sociale, &quot; +&#xD;&#xA;&quot;         s.code_commune, s.code_departement, d.libelle AS nom_departement, r.libelle_norm AS nom_region &quot; +&#xD;&#xA;&quot;  FROM ( &quot; +&#xD;&#xA;&quot;    SELECT identifiant_organisation, type_organisation, finess_site, finess_juridique, raison_sociale, code_commune, code_departement, &quot; +&#xD;&#xA;&quot;           ROW_NUMBER() OVER (PARTITION BY identifiant_organisation ORDER BY raison_sociale) AS rn &quot; +&#xD;&#xA;&quot;    FROM chu_staging.etablissement WHERE load_date = '&quot; + context.load_date + &quot;' AND identifiant_organisation &lt;> '' &quot; +&#xD;&#xA;&quot;  ) s &quot; +&#xD;&#xA;&quot;  LEFT JOIN (SELECT identifiant_organisation FROM chu_dwh.dim_etablissement WHERE sk_etablissement > 0) e &quot; +&#xD;&#xA;&quot;         ON e.identifiant_organisation = s.identifiant_organisation &quot; +&#xD;&#xA;&quot;  LEFT JOIN chu_staging.cog_departement d ON d.code_departement = s.code_departement AND d.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  LEFT JOIN chu_staging.cog_region r ON r.code_region = d.code_region AND r.load_date = '&quot; + context.load_date + &quot;' &quot; +&#xD;&#xA;&quot;  WHERE s.rn = 1 AND e.identifiant_organisation IS NULL &quot; +&#xD;&#xA;&quot;) n&quot;"/>
