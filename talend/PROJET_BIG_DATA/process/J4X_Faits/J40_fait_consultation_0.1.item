        <mapperTableEntries name="sk_localisation" expression="commune.sk_localisation != null ? commune.sk_localisation : departement.sk_localisation != null ? departement.sk_localisation : -1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="age_patient" expression="Var.age" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="tranche_age" expression="Var.tranche" type="id_String" nullable="true"/>
        <mapperTableEntries name="mode_rattachement" expression="prof.mode_rattachement == null ? &quot;INCONNU&quot; : prof.mode_rattachement" type="id_String" nullable="true"/>
        <mapperTableEntries name="nb" expression="1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="annee" expression="Var.annee" type="id_Integer" nullable="true"/>
      </outputTables>
